<?xml version="1.0" encoding="utf-8"?>
<!--
  Spec "Security > Transport": no cleartext, and only Let's Encrypt's ISRG Root X1 and X2 are
  trusted (no system CAs), so another CA cannot be used to intercept traffic. Certificates in
  res/raw were downloaded from https://letsencrypt.org/certificates/ and have these SHA-256
  fingerprints:
    isrg_root_x1.pem  96:BC:EC:06:26:49:76:F3:74:60:77:9A:CF:28:C5:A7:CF:E8:A3:C0:AA:E1:1A:8F:FC:EE:05:C0:BD:DF:08:C6
    isrg_root_x2.pem  69:72:9B:8E:15:A8:6E:FC:17:7A:57:AF:B7:17:1D:FC:64:AD:D2:8C:2F:CA:8C:F1:50:7E:34:45:3C:CB:14:70
  src/debug/res/xml/network_security_config.xml replaces this file for debug builds.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
        </trust-anchors>
    </base-config>
</network-security-config>
