<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- WorkManager runs expedited work as a short data-sync foreground service on Android 10 and 11. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- AlertService (incoming-page ringing): a sideloaded app may use specialUse; see its subtype below. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- TalkService (live talk) is a microphone foreground service; RECORD_AUDIO must be granted before it starts. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Normal (no prompt): needed to switch to call mode and route to the speaker or a headset. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Setup checklist (docs/spec.md, "Permissions and setup checklist"): each is explained and checked there. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Sideloaded family app, not distributed through Play: alerts must not be delayed by Doze. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".PttApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ptt">

        <!-- Firebase is initialised manually (FirebaseOptions from BuildConfig), never at startup,
             and collects no data by default. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_data_collection_default_enabled"
            android:value="false" />

        <!-- Firebase's init provider reads google-services.json values, which this app does not
             use; removing it keeps Firebase from starting before PttApplication decides to. -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />

        <!-- Hilt supplies WorkManager's configuration (PttApplication), so its default initializer goes. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Expedited outbox work runs in this service on Android 10 and 11 (OutboxWorker). -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- FCM data messages (push.FcmService). Never started while Firebase is unconfigured. -->
        <service
            android:name=".push.FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Rings while a page is unanswered (alert.AlertService). -->
        <service
            android:name=".alert.AlertService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Rings and vibrates for an incoming family page until it is answered, acknowledged or cancelled" />
        </service>

        <!-- Live talk (talk.TalkService): started only while TalkActivity is visible and RECORD_AUDIO is granted. -->
        <service
            android:name=".talk.TalkService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- The Acknowledged action on the incoming-page notification. -->
        <receiver
            android:name=".alert.AlertActionReceiver"
            android:exported="false" />

        <!--
            The send entry point (the family widget's Page and Urgent). Not exported, so no other app can start a
            page; not in Recents; and no showWhenLocked, so it never shows over the lock screen: it unlocks first.
        -->
        <activity
            android:name=".talk.SendActivity"
            android:theme="@style/Theme.Ptt.Translucent"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="com.example.ptt.send" />

        <!--
            Placeholder talk screen: shows over the lock screen so notification and full-screen intents work.
            Its own task affinity keeps MainActivity out of that task (Back and End return to the lock screen),
            and it stays out of Recents.
        -->
        <activity
            android:name=".talk.TalkActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:taskAffinity="com.example.ptt.talk"
            android:turnScreenOn="true" />

        <!--
            The home-screen widget. Exported because the launcher host sends it APPWIDGET_UPDATE, enabled and
            deleted broadcasts; it does nothing else with what it receives and holds no secret.
        -->
        <receiver
            android:name=".widget.FamilyWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/family_widget_info" />
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
