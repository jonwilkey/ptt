terraform {
  # 1.10+ is needed for S3-native state locking (use_lockfile). CI runs 1.13.2.
  required_version = "~> 1.13"

  required_providers {
    vultr = {
      source  = "vultr/vultr"
      version = "~> 2.33"
    }
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.70"
    }
  }

  # Bucket created by ../bootstrap. Partial configuration: the bucket name is deployment-specific,
  # so it is passed at init time with `-backend-config=../backend.hcl` (copy
  # ../backend.hcl.example), or in CI with -backend-config="bucket=...". Credentials come from the
  # environment (OIDC role in CI, the admin's own profile on a laptop).
  backend "s3" {
    key          = "prod/terraform.tfstate"
    region       = "us-west-2"
    encrypt      = true # SSE-S3 at rest, on top of OpenTofu's own encryption below
    use_lockfile = true # S3-native locking (prod/terraform.tfstate.tflock); no DynamoDB
  }

  # OpenTofu client-side encryption of state and saved plans. The data key is generated by the
  # KMS key that bootstrap creates, referred to by alias so no account-specific ARN is needed
  # here. There is no fallback method: unencrypted state or plans are refused.
  #
  # The alias and region are literals, matching the locals in ../bootstrap/state.tf. The
  # encryption context is bound into every data key; the CI roles' KMS permissions require
  # stack = "prod" (../bootstrap/github_oidc.tf), so changing it locks CI out.
  encryption {
    key_provider "aws_kms" "state" {
      kms_key_id = "alias/ptt-tofu-state"
      region     = "us-west-2"
      key_spec   = "AES_256"

      encryption_context = {
        stack = "prod"
      }
    }

    method "aes_gcm" "state" {
      keys = key_provider.aws_kms.state
    }

    state {
      method   = method.aes_gcm.state
      enforced = true
    }

    plan {
      method   = method.aes_gcm.state
      enforced = true
    }
  }
}
