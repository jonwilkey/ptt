# Shared partial backend configuration for both root modules. Copy to backend.hcl (git-ignored),
# set the bucket to bootstrap's state_bucket_name, and pass it to every init:
#   tofu -chdir=bootstrap init -backend-config=../backend.hcl
#   tofu -chdir=prod init -backend-config=../backend.hcl
# Each module sets its own key (bootstrap/... or prod/...) and the region in its versions.tf.
# CI passes the same value from the TOFU_STATE_BUCKET secret with -backend-config="bucket=...".
bucket = "example-ptt-tofu-state"
