---
# yamllint settings for infra/ansible, compatible with what ansible-lint requires.
# ansible-lint reads this file too; `yamllint .` from this directory uses it.
extends: default

ignore: |
  .cache/

rules:
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  line-length:
    max: 120
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    allowed-values: ["true", "false"]
