# {{ ansible_managed }}
# Read by docker compose in {{ app_dir }}.
{% if app_image | length > 0 %}
PTTD_IMAGE={{ app_image }}
{% else %}
# PTTD_IMAGE is written by the first deploy (deploy.yml -e pttd_image=...).
{% endif %}
PTT_DOMAIN={{ ptt_domain }}
{% if app_secrets | selectattr('dest', 'equalto', app_fcm_secret_dest) | list | length > 0 %}
PTTD_FCM_CREDENTIALS_FILE=/run/secrets/ptt/{{ app_fcm_secret_dest }}
{% endif %}
{% if app_secrets | selectattr('dest', 'equalto', app_healthchecks_secret_dest) | list | length > 0 %}
PTTD_HEALTHCHECKS_PING_KEY_FILE=/run/secrets/ptt/{{ app_healthchecks_secret_dest }}
{% endif %}
