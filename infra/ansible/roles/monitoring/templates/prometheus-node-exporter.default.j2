# {{ ansible_managed }}
# Read by prometheus-node-exporter.service. Listens on this node's Tailscale IPv4 address
# only; the firewall also allows port {{ monitoring_exporter_port }} on tailscale0 only. If the
# node is re-registered and its address changes, rerun Ansible.
ARGS="--web.listen-address={{ monitoring_tailscale_ip4.stdout }}:{{ monitoring_exporter_port }}{{ ' ' ~ monitoring_exporter_extra_args if monitoring_exporter_extra_args | length > 0 else '' }}"
