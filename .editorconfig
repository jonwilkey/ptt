root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[{go.mod,go.sum,go.work}]
indent_style = tab
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab
indent_size = 4

[*.{kt,kts}]
indent_size = 4

[*.{java,xml,gradle}]
indent_size = 4

[*.{yml,yaml,json,hcl,tf,tfvars}]
indent_size = 2

[*.sql]
indent_size = 2

[*.py]
indent_size = 4
