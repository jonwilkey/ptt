{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "America/Los_Angeles",
  "semanticCommits": "enabled",
  "postUpdateOptions": ["gomodTidy"],
  "osvVulnerabilityAlerts": true,
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "GitHub Actions, Go modules, and Docker base images: auto-merge patch and minor updates (and digest pins/refreshes) when CI passes.",
      "matchManagers": ["github-actions", "gomod", "dockerfile", "docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "automerge": true
    },
    {
      "description": "Android and Gradle dependencies: one grouped PR per month, merged by a person after a quick check.",
      "matchManagers": ["gradle", "gradle-wrapper"],
      "groupName": "Android and Gradle dependencies",
      "schedule": ["* 0-3 1 * *"],
      "automerge": false
    },
    {
      "description": "OpenTofu/Terraform providers: kept current, merged by a person.",
      "matchManagers": ["terraform"],
      "automerge": false
    },
    {
      "description": "Major versions are never auto-merged. Keep this rule last so it wins.",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
